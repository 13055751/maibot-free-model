{
  "manifest_version": 2,
  "id": "org.tsukikage.our-free-model",
  "version": "1.0.0",
  "name": "Our Free Model",
  "description": "把 dsh 的 dsh-our-free-model 免费模型能力接到麦麦：随插件运行一个本机 sidecar，提供匿名免费车道、Kilo 免密池与十个账号渠道，统一以一个 @LLMProvider 暴露。模型清单用 /ofm toml 生成后粘进 model_config.toml。",
  "author": {
    "name": "tsukikage",
    "url": "https://github.com/tsukikage"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/tsukikage/maibot-free-model",
    "documentation": "https://docs.mai-mai.org/plugin/llmprovider.html",
    "issues": "https://github.com/tsukikage/maibot-free-model/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "999.999.999"
  },
  "dependencies": [],
  "plugin_type": "provider",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "sparkles",
      "background": "#263146"
    }
  },
  "capabilities": ["send.text"],
  "llm_providers": [
    {
      "client_type": "our_free_model",
      "name": "Our Free Model",
      "description": "免费模型车道：匿名池、Kilo 免密池与十个账号渠道，由本机 sidecar 承载",
      "version": "1.0.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
